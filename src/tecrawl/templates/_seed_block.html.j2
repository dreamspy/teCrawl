{# One seed's full results block: header (playable seed) + candidate groups.
   Used by both the playlist page and the quick-search page, so they can't
   drift apart visually. `groups` is [(source, [Candidate, …]), …]. #}
{% from "_cand_row.html.j2" import cand_row %}
{% macro seed_block(seed, release, groups) %}
<div class="seed">
  <div class="seed-head">
    <span class="seed-plays">
      {% if seed.spotify_id %}
        <button class="play" data-spotify-id="{{ seed.spotify_id }}" data-spotify-type="track" onclick="togglePlay(this)" title="Play preview / full track">▶</button>
      {% else %}
        <button class="play disabled" disabled title="Not on Spotify">▶</button>
      {% endif %}
      {% if seed.youtube_id %}
        <button class="play yt" data-yt-id="{{ seed.youtube_id }}" onclick="togglePlayYT(this)" title="Play on YouTube">▶</button>
      {% endif %}
    </span>
    <div class="seed-info">
      <div class="seed-title">
        {% if seed.spotify_id %}<a href="{{ spotify_track_url(seed.spotify_id) }}" target="_blank" rel="noopener">{{ seed.title }}</a>{% else %}{{ seed.title }}{% endif %}
      </div>
      <div class="seed-artist">{{ seed.artist }}</div>
    </div>
    <span class="seed-actions">
      {# A seed is always a track, and spotify.Track carries only the bare id,
         so there is no spotify_url to branch on the way a Candidate has. #}
      {% if seed.spotify_id %}
        <a href="{{ spotify_track_url(seed.spotify_id) }}" target="_blank" rel="noopener" class="ext spt" title="Open track on Spotify">SPT↗</a>
      {% else %}
        <a href="{{ spotify_search_url(seed.artist, seed.title) }}" target="_blank" rel="noopener" class="ext spt secondary" title="No Spotify match — search Spotify for this track">SPT↗</a>
      {% endif %}
      <a href="{{ lastfm_url(seed.artist, seed.title) }}" target="_blank" rel="noopener" class="ext lfm" title="Browse on Last.fm">LFM↗</a>
      {% if release and release.exact and release.release_id %}
        <a href="https://www.discogs.com/release/{{ release.release_id }}" target="_blank" rel="noopener" class="ext dgs" title="Open release on Discogs">DGS↗</a>
      {% else %}
        <a href="{{ discogs_search_url(seed.artist, seed.title) }}" target="_blank" rel="noopener" class="ext dgs" title="Search on Discogs">DGS↗</a>
      {% endif %}
      <a href="{{ dig_url(seed.artist, seed.title) }}" class="ext dig" title="Dig from here — new search seeded on this track (⌘/Ctrl-click for a new tab)">Dig↗</a>
      {# ⬇ only — no thumbs on a seed, since a seed is an input, not a
         recommendation to judge. Worth having on a quick search, where the
         seed is a track you pasted and may well want to grab. #}
      <span class="fb" data-artist="{{ seed.artist }}" data-title="{{ seed.title }}" data-context="seed">
        <button class="cp" onclick="copyTrack(this)" title="Copy &quot;Artist - Title&quot; to the clipboard">copy</button>
        <button class="dl" onclick="toggleDownload(this)" title="Add to download queue">⬇ queue</button>
      </span>
    </span>
  </div>
  {# Angles that produced nothing are invisible otherwise — a seed whose
     Discogs anchor failed used to render as a single Last.fm section with no
     hint that five other angles had been skipped. Say so out loud. #}
  {% set present = groups | map(attribute=0) | list %}
  {% set missing = [] %}
  {% for s in all_sources if s not in present
       and not (release is none and s.startswith('discogs_')) %}
    {% set _ = missing.append(s) %}
  {% endfor %}
  {% if missing or (release and not release.exact) %}
  <div class="coverage">
    {% if not release %}
      No Discogs release found for this artist, so the five Discogs angles were skipped.
    {% elif not release.exact %}
      Discogs has no match for this exact track — the Discogs angles are anchored on
      <a href="https://www.discogs.com/release/{{ release.release_id }}" target="_blank" rel="noopener">{{ release.title }}</a>
      by {{ release.artist }} instead.
    {% endif %}
    {% if missing %}
      <span class="cov-missing">Nothing came back from: {% for s in missing %}{{ source_labels.get(s, s) }}{% if not loop.last %} · {% endif %}{% endfor %}.</span>
    {% endif %}
  </div>
  {% endif %}
  {% if groups %}
    {% for source, group in groups %}
    <div class="group-head">
      <span>{{ source_labels.get(source, source) }} <span class="group-desc">— {{ source_descriptions.get(source, '') }}</span></span>
      <button class="playall-mini" onclick="toggleQueue(this)" title="Play this section, then continue into the rest of the page">▶</button>
    </div>
    <div class="group">
    {% for c in group %}
    {{ cand_row(c, seed) }}
    {% endfor %}
    </div>
    {# "Show more" only on the deep Discogs angles that can paginate further.
       It hits /api/more (needs the server running), so it silently no-ops on
       a page opened straight off disk. #}
    {% set can_more = release and (
         (source == 'discogs_artist' and release.artist_id) or
         (source in ('discogs_label', 'discogs_label_mate') and release.label_id) or
         (source == 'discogs_style' and release.styles)
       ) %}
    {% if can_more %}
    <button class="showmore" onclick="showMore(this)"
      data-source="{{ source }}"
      data-artist-id="{{ release.artist_id or '' }}"
      data-label-id="{{ release.label_id or '' }}"
      data-release-id="{{ release.release_id or '' }}"
      data-styles="{{ release.styles|join('|') }}"
      data-label="{{ release.label or '' }}"
      data-seed-artist="{{ seed.artist }}"
      data-seed-title="{{ seed.title }}"
      data-page="1" data-batch="10">↓ Show 10 more · {{ source_labels.get(source, source) }}</button>
    {% endif %}
    {% endfor %}
  {% else %}
    <div class="empty">No candidates.</div>
  {% endif %}
</div>
{% endmacro %}
