<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>teCrawl — quick search</title>
<style>
{% include "_style.css" %}
.status {
  display: flex;
  align-items: center;
  gap: .6rem;
  color: var(--muted);
  font-size: .9rem;
  min-height: 1.6rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.status.error { color: #ff7c7c; }
.status.stopped { color: #e0a640; }
.spinner {
  width: 14px; height: 14px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin .8s linear infinite;
  flex: none;
}
@keyframes spin { to { transform: rotate(360deg); } }
.stopbtn {
  background: var(--card);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: .15rem .6rem;
  font-size: .78rem;
  cursor: pointer;
}
.stopbtn:hover:not(:disabled) { border-color: #ff7c7c; color: #ff7c7c; }
.stopbtn:disabled { opacity: .5; cursor: default; }
.elapsed { color: #555; }
.permalink { margin-left: auto; }
.seedline { color: var(--text); font-size: .95rem; margin: 0 0 .75rem; }
.seedline .note { color: var(--muted); font-size: .8rem; }
.notes { color: var(--muted); font-size: .8rem; margin: -0.75rem 0 1rem; }
.notes div { margin: .15rem 0; }
.searchbar button.browse {
  background: var(--card);
  color: var(--text);
  border: 1px solid var(--border);
  font-weight: 400;
  white-space: nowrap;
}
.searchbar button.browse:hover { border-color: var(--accent); color: var(--accent); background: var(--card); }
.opts {
  display: flex;
  align-items: center;
  gap: .4rem;
  margin: -0.5rem 0 1.25rem;
  color: var(--muted);
  font-size: .82rem;
}
.opts input { accent-color: var(--accent); cursor: pointer; }
.opts label { cursor: pointer; user-select: none; }
.opts .fresnote { color: #555; }
.footer {
  margin-top: 3rem;
  padding-top: .75rem;
  border-top: 1px solid var(--border);
  color: #555;
  font-size: .72rem;
}
</style>
</head>
<body>
<div class="wrap">
<div class="meta"><a href="/">← All playlists</a> · <a href="/queue">⬇ Download queue</a></div>
<h1>teCrawl — quick search</h1>
<form class="searchbar" id="f">
  <input id="q" name="q" placeholder="Track name, Spotify/YouTube link, or folder path" autocomplete="off" autofocus value="{{ q or '' }}">
  <button id="browse" type="button" class="browse" title="Pick a folder of audio files (the picker opens on the Mac running the server)">📁 Browse</button>
  <button id="go" type="submit">Dig</button>
</form>
<div class="hint">Works with <code>Artist - Title</code>, free text, <code>open.spotify.com/track/…</code> (album links too), <code>youtube.com/watch…</code> / <code>youtu.be/…</code>, or a local folder of audio files (<code>/Users/you/Music/crate</code>) — tags first, filenames as fallback</div>
<div class="opts">
  <input type="checkbox" id="fresh" {% if fresh %}checked{% endif %}>
  <label for="fresh">Fresh dig <span class="fresnote">— skip the cache and re-fetch every source (slower)</span></label>
</div>
<div class="seedline" id="seedline" hidden></div>
<div class="notes" id="notes" hidden></div>
<div class="status" id="status" hidden>
  <span class="spinner" id="spin" hidden></span>
  <span id="msg"></span>
  <span class="elapsed" id="elapsed"></span>
  <button class="stopbtn" id="stopbtn" type="button" hidden>■ Stop</button>
  <a class="permalink" id="permalink" hidden target="_blank" rel="noopener">permalink</a>
</div>
<div class="queuebar" id="queuebar" hidden>
  <button class="playall" onclick="toggleQueue()">▶ Play all</button>
  <span class="queuehint">plays every rec via YouTube · media keys skip tracks, even in the background</span>
</div>
<div id="results"></div>
<div class="footer">server started {{ server_started }} · after updating teCrawl, restart <code>tecrawl serve</code> to pick up new features</div>
</div>
<script src="https://open.spotify.com/embed/iframe-api/v1" async></script>
<script src="https://www.youtube.com/iframe_api" async></script>
<script>
{% include "_player.js" %}
</script>
<script>
(function () {
  const form = document.getElementById('f');
  const input = document.getElementById('q');
  const freshBox = document.getElementById('fresh');
  const go = document.getElementById('go');
  const statusEl = document.getElementById('status');
  const spin = document.getElementById('spin');
  const msg = document.getElementById('msg');
  const elapsedEl = document.getElementById('elapsed');
  const stopBtn = document.getElementById('stopbtn');
  const permalink = document.getElementById('permalink');
  const seedline = document.getElementById('seedline');
  const notes = document.getElementById('notes');
  const queuebar = document.getElementById('queuebar');
  const results = document.getElementById('results');
  let es = null, timer = null, t0 = 0;

  function stop(finalMsg, isError, isStopped) {
    if (es) { es.close(); es = null; }
    if (timer) { clearInterval(timer); timer = null; }
    spin.hidden = true;
    go.disabled = false;
    stopBtn.hidden = true;
    stopBtn.disabled = false;
    msg.textContent = finalMsg;
    statusEl.classList.toggle('error', !!isError);
    statusEl.classList.toggle('stopped', !!isStopped);
  }

  function start(q) {
    if (!q) return;
    if (es) { es.close(); es = null; }
    if (timer) { clearInterval(timer); timer = null; }
    closeAllEmbeds();
    if (typeof queueStop === 'function') queueStop();
    results.innerHTML = '';
    seedline.hidden = true;
    seedline.textContent = '';
    notes.hidden = true;
    notes.innerHTML = '';
    queuebar.hidden = true;
    permalink.hidden = true;
    statusEl.hidden = false;
    statusEl.classList.remove('error');
    statusEl.classList.remove('stopped');
    spin.hidden = false;
    go.disabled = true;
    stopBtn.hidden = false;
    stopBtn.disabled = false;
    msg.textContent = 'Starting…';
    elapsedEl.textContent = '';
    t0 = Date.now();
    timer = setInterval(function () {
      elapsedEl.textContent = Math.round((Date.now() - t0) / 1000) + 's';
    }, 1000);
    const fresh = freshBox && freshBox.checked;
    const freshParam = fresh ? '&fresh=1' : '';
    history.replaceState(null, '', '/search?q=' + encodeURIComponent(q) + freshParam);

    es = new EventSource('/api/discover?q=' + encodeURIComponent(q) + freshParam);
    es.onmessage = function (e) {
      let d;
      try { d = JSON.parse(e.data); } catch (err) { return; }
      if (d.type === 'status') {
        msg.textContent = d.message;
      } else if (d.type === 'seed') {
        seedline.hidden = false;
        seedline.textContent = '';
        const strong = document.createElement('strong');
        strong.textContent = d.artist + ' — ' + d.title;
        seedline.appendChild(document.createTextNode('Digging from: '));
        seedline.appendChild(strong);
        if (d.note) {
          const note = document.createElement('span');
          note.className = 'note';
          note.textContent = ' · ' + d.note;
          seedline.appendChild(note);
        }
      } else if (d.type === 'note') {
        notes.hidden = false;
        const div = document.createElement('div');
        div.textContent = d.message;
        notes.appendChild(div);
      } else if (d.type === 'seed_html') {
        results.insertAdjacentHTML('beforeend', d.html);
        applyRowStates(results);
      } else if (d.type === 'result') {
        results.innerHTML = d.html;
        applyRowStates(results);
        seedline.hidden = true;
        queuebar.hidden = false;
        if (d.permalink) { permalink.href = d.permalink; permalink.hidden = false; }
        stop('Done in ' + d.elapsed + 's · ' + d.candidates + ' candidates', false);
      } else if (d.type === 'done') {
        if (d.tops_html) results.insertAdjacentHTML('afterbegin', d.tops_html);
        applyRowStates(results);
        queuebar.hidden = false;
        if (d.permalink) { permalink.href = d.permalink; permalink.hidden = false; }
        stop('Done in ' + d.elapsed + 's · ' + d.seeds + ' seeds · '
             + d.candidates + ' candidates', false);
      } else if (d.type === 'stopped') {
        if (d.tops_html) {
          results.insertAdjacentHTML('afterbegin', d.tops_html);
          applyRowStates(results);
        }
        if (d.permalink) {
          permalink.href = d.permalink;
          permalink.hidden = false;
          queuebar.hidden = false;
        }
        seedline.hidden = true;
        let text = 'Stopped early';
        if (d.seeds != null) {
          text += ' · ' + d.seeds + ' seed' + (d.seeds === 1 ? '' : 's') + ' completed';
        }
        if (d.candidates != null) text += ' · ' + d.candidates + ' candidates';
        if (d.elapsed != null) text += ' (' + d.elapsed + 's)';
        stop(text, false, true);
      } else if (d.type === 'error') {
        stop(d.message, true);
      }
    };
    es.onerror = function () {
      if (es) stop('Connection lost · is the server still running?', true);
    };
  }

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    start(input.value.trim());
  });

  stopBtn.addEventListener('click', function () {
    stopBtn.disabled = true;
    msg.textContent = 'Stopping…';
    fetch('/api/stop', { method: 'POST' }).catch(function () {});
  });

  const browse = document.getElementById('browse');
  browse.addEventListener('click', async function () {
    browse.disabled = true;
    try {
      const r = await fetch('/api/pick-folder');
      const d = await r.json();
      if (d.path) {
        input.value = d.path;
        start(d.path);
      } else if (d.error) {
        statusEl.hidden = false;
        statusEl.classList.add('error');
        msg.textContent = d.error;
      }
      // neither: user hit Cancel in the picker — do nothing
    } catch (e) {
      statusEl.hidden = false;
      statusEl.classList.add('error');
      msg.textContent = 'Folder picker failed — type or paste the path instead.';
    } finally {
      browse.disabled = false;
    }
  });

  if (input.value.trim()) start(input.value.trim());
})();
</script>
</body>
</html>
