<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>teCrawl{% if playlist_name %} — {{ playlist_name }}{% endif %}</title>
<style>
:root {
  --bg: #0a0a0a;
  --card: #161616;
  --text: #e8e8e8;
  --muted: #888;
  --accent: #1db954;
  --border: #2a2a2a;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  padding: 2rem 1rem;
  line-height: 1.4;
}
.wrap { max-width: 920px; margin: 0 auto; }
h1 { margin: 0 0 .5rem; font-size: 1.4rem; font-weight: 600; }
.meta { color: var(--muted); font-size: .85rem; margin-bottom: 2rem; }
.seed {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0 1.25rem 1.25rem;
  margin-bottom: 2rem;
  overflow: hidden;
}
.seed-head {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 1rem;
  align-items: center;
  padding: 1.5rem 1.25rem;
  margin: 0 -1.25rem 1.25rem;
  background: linear-gradient(90deg, rgba(29,185,84,0.22), rgba(29,185,84,0.05));
  border-bottom: 2px solid var(--accent);
}
.seed-head .play {
  width: 44px;
  height: 44px;
  font-size: 1rem;
}
.seed-info { min-width: 0; }
.seed-title { font-size: 1.8rem; font-weight: 700; margin: 0; line-height: 1.15; }
.seed-title a { color: var(--text); font-size: inherit; }
.seed-title a:hover { color: var(--accent); text-decoration: none; }
.seed-artist { color: var(--muted); font-size: 1.05rem; margin: .3rem 0 0; }
.cand {
  display: grid;
  grid-template-columns: auto 1fr auto auto auto auto auto;
  gap: .75rem;
  align-items: center;
  padding: .7rem .75rem;
  border-radius: 6px;
  font-size: .9rem;
}
.cand:nth-child(odd) { background: #1d1d1d; }
.cand:hover { background: #242424; }
.play {
  background: transparent;
  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: 50%;
  width: 26px;
  height: 26px;
  cursor: pointer;
  font-size: .7rem;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: inherit;
}
.play:hover { background: var(--accent); color: #000; }
.play.disabled { border-color: #333; color: #333; cursor: default; }
.play.disabled:hover { background: transparent; color: #333; }
.play.yt {
  color: #ff4c4c;
  border-color: #ff4c4c;
}
.play.yt:hover { background: #ff4c4c; color: #000; }
.embed iframe.yt { height: 220px; }
.yt-fallback {
  display: inline-block;
  margin-top: .35rem;
  font-size: .75rem;
  color: #ff7c7c;
}
.yt-fallback:hover { color: #ff4c4c; text-decoration: underline; }
.yt-cell {
  display: inline-flex;
  gap: .35rem;
  align-items: center;
}
.yt-search {
  font-size: .7rem;
  color: #ff7c7c;
  border: 1px solid #ff4c4c40;
  border-radius: 3px;
  padding: .15rem .35rem;
  white-space: nowrap;
}
.yt-search:hover { background: #ff4c4c20; color: #ff4c4c; text-decoration: none; }
.ext {
  font-size: .7rem;
  border-radius: 3px;
  padding: .15rem .35rem;
  white-space: nowrap;
  border: 1px solid;
}
.ext.lfm { color: #d44; border-color: #d4444040; }
.ext.lfm:hover { background: #d4444020; color: #d44; text-decoration: none; }
.ext.dgs { color: #d4a651; border-color: #d4a65140; }
.ext.dgs:hover { background: #d4a65120; color: #d4a651; text-decoration: none; }
.embed {
  grid-column: 1 / -1;
  margin-top: .5rem;
}
.embed iframe {
  width: 100%;
  height: 80px;
  border: 0;
  border-radius: 6px;
}
.embed iframe.album { height: 152px; }
.cand-info { min-width: 0; }
.cand-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cand-artist {
  color: var(--muted);
  font-size: .8rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tag {
  font-size: .68rem;
  padding: .15rem .45rem;
  border-radius: 3px;
  white-space: nowrap;
  text-transform: uppercase;
  letter-spacing: .03em;
}
.tag.discogs_label { background: #2a1f0a; color: #d4a651; }
.tag.discogs_artist { background: #1a1a2a; color: #8888d4; }
.tag.discogs_label_mate { background: #2a1f0a; color: #b88a3a; }
.tag.discogs_style { background: #1f0a2a; color: #b46ad4; }
.tag.lastfm_track { background: #2a0a0a; color: #d44; }
.tag.lastfm_artist { background: #2a0a1a; color: #d46; }
.detail {
  color: var(--muted);
  font-size: .75rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200px;
}
a { color: var(--accent); text-decoration: none; font-size: .85rem; }
a:hover { text-decoration: underline; }
a.secondary { color: #888; }
.empty { color: var(--muted); font-size: .85rem; font-style: italic; }
.group-head {
  margin: 1.5rem 0 .4rem;
  font-size: .95rem;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--text);
  font-weight: 700;
  padding-bottom: .35rem;
  border-bottom: 1px solid var(--border);
}
.group-head:first-of-type { margin-top: .5rem; }
.group-desc {
  font-style: italic;
  font-weight: 400;
  font-size: .75rem;
  letter-spacing: 0;
  text-transform: none;
  color: var(--muted);
  margin-left: .35rem;
}
.group { display: flex; flex-direction: column; gap: .25rem; }
.top-picks {
  background: linear-gradient(135deg, rgba(29,185,84,0.12), rgba(180,106,212,0.08));
  border: 1px solid #2e2e2e;
  border-radius: 10px;
  padding: 1.25rem 1.5rem 1.5rem;
  margin-bottom: 2.5rem;
}
.top-picks h2 {
  margin: 0 0 .25rem;
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: .02em;
}
.top-picks .sub {
  color: var(--muted);
  font-size: .85rem;
  margin-bottom: 1rem;
}
.pick {
  display: grid;
  grid-template-columns: auto 1fr auto auto auto auto auto;
  gap: .75rem;
  align-items: center;
  padding: .7rem .75rem;
  border-radius: 6px;
  font-size: .9rem;
}
.pick:nth-child(odd) { background: rgba(255,255,255,0.03); }
.pick:hover { background: rgba(255,255,255,0.06); }
.pick-info { min-width: 0; }
.pick-title {
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pick-artist {
  color: var(--muted);
  font-size: .8rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pick-meta {
  color: var(--muted);
  font-size: .75rem;
  white-space: nowrap;
  max-width: 280px;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hits-badge {
  background: var(--accent);
  color: #000;
  font-size: .7rem;
  font-weight: 700;
  padding: .2rem .55rem;
  border-radius: 10px;
  white-space: nowrap;
  border: 0;
  cursor: pointer;
  font-family: inherit;
}
.hits-badge:hover { background: #1ed760; }
.hits-badge::after { content: " ▼"; font-size: .85rem; margin-left: .15rem; }
.hits-badge.open::after { content: " ▲"; }
.seed-list {
  grid-column: 1 / -1;
  margin-top: .4rem;
  padding: .5rem .25rem;
  border-top: 1px dashed var(--border);
  display: flex;
  flex-direction: column;
  gap: .15rem;
}
.seed-list[hidden] { display: none; }
.seed-row {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: .6rem;
  align-items: center;
  padding: .35rem .5rem;
  border-radius: 4px;
  font-size: .85rem;
  color: var(--muted);
}
.seed-row:hover { background: rgba(255,255,255,0.04); color: var(--text); }
.seed-row .play { width: 22px; height: 22px; font-size: .6rem; }
</style>
</head>
<body>
<div class="wrap">
<div class="meta"><a href="/">← All playlists</a></div>
<h1>teCrawl{% if playlist_name %} — {{ playlist_name }}{% endif %}</h1>
<div class="meta">Generated {{ generated_at }} · {{ seeds|length }} seed track{% if seeds|length != 1 %}s{% endif %}</div>

{% if top_picks %}
<div class="top-picks">
  <h2>★ Top picks</h2>
  <div class="sub">Surfaced from {{ top_picks|length }} candidate{% if top_picks|length != 1 %}s{% endif %} that appeared across multiple seed tracks — strong cross-signal.</div>
  {% for p in top_picks %}
  <div class="pick">
    {% if p.spotify_id %}
      <button class="play" data-spotify-id="{{ p.spotify_id }}" data-spotify-type="{{ p.spotify_type }}" onclick="togglePlay(this)" title="Play preview / full track">▶</button>
    {% else %}
      <button class="play disabled" disabled title="Not on Spotify">▶</button>
    {% endif %}
    <div class="pick-info">
      <div class="pick-title">{{ p.title }}</div>
      <div class="pick-artist">{{ p.artist }}</div>
    </div>
    <button class="hits-badge" onclick="toggleSeedList(this)" title="Show seeds that surfaced this">{{ p.hits }}× seeds</button>
    {% if p.spotify_url %}
      <a href="{{ p.spotify_url }}" target="_blank" rel="noopener">Spotify</a>
    {% else %}
      <a href="{{ spotify_search_url(p.artist, p.title) }}" target="_blank" rel="noopener" class="secondary">Search</a>
    {% endif %}
    <span class="yt-cell">
      {% if p.youtube_id %}
        <button class="play yt" data-yt-id="{{ p.youtube_id }}" onclick="togglePlayYT(this)" title="Play on YouTube">▶</button>
      {% endif %}
      <a href="{{ youtube_search_url(p.artist, p.title) }}" target="_blank" rel="noopener" class="yt-search" title="Search on YouTube (use if the auto-pick is wrong)">YT↗</a>
    </span>
    <a href="{{ lastfm_url(p.artist, p.title) }}" target="_blank" rel="noopener" class="ext lfm" title="Browse on Last.fm">LFM↗</a>
    {% if p.discogs_release_id %}
      <a href="https://www.discogs.com/release/{{ p.discogs_release_id }}" target="_blank" rel="noopener" class="ext dgs" title="Open release on Discogs">DGS↗</a>
    {% else %}
      <a href="{{ discogs_search_url(p.artist, p.title) }}" target="_blank" rel="noopener" class="ext dgs" title="Search on Discogs">DGS↗</a>
    {% endif %}
    <div class="seed-list" hidden>
      {% for s in p.seeds %}
      <div class="seed-row">
        {% if s.spotify_id %}
          <button class="play" data-spotify-id="{{ s.spotify_id }}" data-spotify-type="track" onclick="togglePlay(this)" title="Play seed preview">▶</button>
        {% else %}
          <button class="play disabled" disabled title="Not on Spotify">▶</button>
        {% endif %}
        <span>{{ s.display }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

{% for seed, release, candidates in seeds %}
<div class="seed">
  <div class="seed-head">
    {% if seed.spotify_id %}
      <button class="play" data-spotify-id="{{ seed.spotify_id }}" data-spotify-type="track" onclick="togglePlay(this)" title="Play preview / full track">▶</button>
    {% else %}
      <button class="play disabled" disabled title="Not on Spotify">▶</button>
    {% endif %}
    <div class="seed-info">
      <div class="seed-title">
        {% if seed.spotify_id %}<a href="https://open.spotify.com/track/{{ seed.spotify_id }}" target="_blank" rel="noopener">{{ seed.title }}</a>{% else %}{{ seed.title }}{% endif %}
      </div>
      <div class="seed-artist">{{ seed.artist }}</div>
    </div>
    <a href="{{ lastfm_url(seed.artist, seed.title) }}" target="_blank" rel="noopener" class="ext lfm" title="Browse on Last.fm">LFM↗</a>
    {% if release and release.release_id %}
      <a href="https://www.discogs.com/release/{{ release.release_id }}" target="_blank" rel="noopener" class="ext dgs" title="Open release on Discogs">DGS↗</a>
    {% else %}
      <a href="{{ discogs_search_url(seed.artist, seed.title) }}" target="_blank" rel="noopener" class="ext dgs" title="Search on Discogs">DGS↗</a>
    {% endif %}
  </div>
  {% if candidates %}
    {% for source, group in candidates %}
    <div class="group-head">{{ source_labels[source] }} <span class="group-desc">— {{ source_descriptions[source] }}</span></div>
    <div class="group">
    {% for c in group %}
    <div class="cand">
      {% if c.spotify_id %}
        <button class="play" data-spotify-id="{{ c.spotify_id }}" data-spotify-type="{{ c.spotify_type }}" onclick="togglePlay(this)" title="Play preview / full track">▶</button>
      {% else %}
        <button class="play disabled" disabled title="Not on Spotify">▶</button>
      {% endif %}
      <div class="cand-info">
        <div class="cand-title">{{ c.title }}</div>
        <div class="cand-artist">{{ c.artist }}</div>
      </div>
      <span class="detail" title="{{ c.source_detail }}">{{ c.source_detail }}</span>
      {% if c.spotify_url %}
        <a href="{{ c.spotify_url }}" target="_blank" rel="noopener">Spotify</a>
      {% else %}
        <a href="{{ spotify_search_url(c.artist, c.title) }}" target="_blank" rel="noopener" class="secondary">Search</a>
      {% endif %}
      <span class="yt-cell">
        {% if c.youtube_id %}
          <button class="play yt" data-yt-id="{{ c.youtube_id }}" onclick="togglePlayYT(this)" title="Play on YouTube">▶</button>
        {% endif %}
        <a href="{{ youtube_search_url(c.artist, c.title) }}" target="_blank" rel="noopener" class="yt-search" title="Search on YouTube (use if the auto-pick is wrong)">YT↗</a>
      </span>
      <a href="{{ lastfm_url(c.artist, c.title) }}" target="_blank" rel="noopener" class="ext lfm" title="Browse on Last.fm">LFM↗</a>
      {% if c.discogs_release_id %}
        <a href="https://www.discogs.com/release/{{ c.discogs_release_id }}" target="_blank" rel="noopener" class="ext dgs" title="Open release on Discogs">DGS↗</a>
      {% else %}
        <a href="{{ discogs_search_url(c.artist, c.title) }}" target="_blank" rel="noopener" class="ext dgs" title="Search on Discogs">DGS↗</a>
      {% endif %}
    </div>
    {% endfor %}
    </div>
    {% endfor %}
  {% else %}
    <div class="empty">No candidates.</div>
  {% endif %}
</div>
{% endfor %}
</div>
<script src="https://open.spotify.com/embed/iframe-api/v1" async></script>
<script>
let SpotifyAPI = null;
let activeController = null;
let pendingClick = null;

window.onSpotifyIframeApiReady = function (api) {
  SpotifyAPI = api;
  if (pendingClick) {
    const btn = pendingClick;
    pendingClick = null;
    togglePlay(btn);
  }
};

function closeAllEmbeds() {
  if (activeController) {
    try { activeController.destroy(); } catch (e) {}
    activeController = null;
  }
  document.querySelectorAll('.embed').forEach(function (e) {
    const host = e.closest('.cand, .seed-head, .pick, .seed-row');
    const otherBtn = host && host.querySelector('.play');
    if (otherBtn) otherBtn.textContent = '▶';
    e.remove();
  });
}

function toggleSeedList(btn) {
  const pick = btn.closest('.pick');
  const list = pick.querySelector('.seed-list');
  if (!list) return;
  const wasOpen = !list.hidden;
  // Close any other open lists so only one expands at a time.
  document.querySelectorAll('.seed-list').forEach(function (l) {
    if (l !== list) {
      l.hidden = true;
      const otherBadge = l.closest('.pick').querySelector('.hits-badge');
      if (otherBadge) otherBadge.classList.remove('open');
    }
  });
  if (wasOpen) {
    // Collapsing — kill any preview playing inside this list so audio
    // doesn't keep going while the row is hidden.
    if (list.querySelector('.embed')) closeAllEmbeds();
  }
  list.hidden = wasOpen;
  btn.classList.toggle('open', !wasOpen);
}

function togglePlayYT(btn) {
  const host = btn.closest('.cand, .seed-head, .pick, .seed-row');
  const existing = host.querySelector('.embed');
  if (existing) {
    closeAllEmbeds();
    return;
  }
  closeAllEmbeds();
  const id = btn.dataset.ytId;
  const wrap = document.createElement('div');
  wrap.className = 'embed';
  const iframe = document.createElement('iframe');
  iframe.className = 'yt';
  iframe.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
  iframe.allow = 'autoplay; encrypted-media';
  iframe.allowFullscreen = true;
  wrap.appendChild(iframe);
  // Always-visible fallback link — when the uploader has disabled embedding
  // (Error 153), the iframe shows "Watch on YouTube" but it's faster to give
  // the user an explicit, obvious escape hatch right under the player.
  const fallback = document.createElement('a');
  fallback.href = 'https://www.youtube.com/watch?v=' + id;
  fallback.target = '_blank';
  fallback.rel = 'noopener';
  fallback.className = 'yt-fallback';
  fallback.textContent = '↗ Open on YouTube';
  wrap.appendChild(fallback);
  host.appendChild(wrap);
  btn.textContent = '⏸';
}

function togglePlay(btn) {
  const cand = btn.closest('.cand, .seed-head, .pick, .seed-row');
  const existing = cand.querySelector('.embed');
  if (existing) {
    closeAllEmbeds();
    return;
  }
  // If the API isn't ready yet, defer this click and run when it loads.
  if (!SpotifyAPI) {
    pendingClick = btn;
    btn.textContent = '…';
    return;
  }
  closeAllEmbeds();

  const wrap = document.createElement('div');
  wrap.className = 'embed';
  const placeholder = document.createElement('div');
  wrap.appendChild(placeholder);
  cand.appendChild(wrap);
  btn.textContent = '⏸';

  const kind = btn.dataset.spotifyType || 'track';
  const uri = 'spotify:' + kind + ':' + btn.dataset.spotifyId;
  SpotifyAPI.createController(
    placeholder,
    {
      width: '100%',
      height: kind === 'album' ? 152 : 80,
    },
    function (controller) {
      activeController = controller;
      let playedOnce = false;
      // Two-stage init: create the player empty, then on 'ready' load the
      // URI and immediately call play(). loadUri+play in the same tick is
      // the pattern that survives browser autoplay policy because both
      // calls happen synchronously after the user-initiated 'ready' event.
      controller.addListener('ready', function () {
        if (playedOnce) return;
        playedOnce = true;
        controller.loadUri(uri);
        controller.play();
      });
      // Fallback if 'ready' fired before our listener attached (race
      // condition on cold start): try once after a short delay.
      setTimeout(function () {
        if (!playedOnce) {
          playedOnce = true;
          try { controller.loadUri(uri); controller.play(); } catch (e) {}
        }
      }, 800);
    }
  );
}
</script>
</body>
</html>
