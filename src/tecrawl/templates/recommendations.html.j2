<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>teCrawl{% if playlist_name %} — {{ playlist_name }}{% endif %}</title>
<style>
{% include "_style.css" %}
</style>
</head>
<body>
<div class="wrap">
<div class="meta"><a href="/">← All playlists</a> · <a href="/queue">⬇ Download queue</a></div>
<h1>teCrawl{% if playlist_name %} — {{ playlist_name }}{% endif %}</h1>
<div class="meta">Generated {{ generated_at }} · {{ seeds|length }} seed track{% if seeds|length != 1 %}s{% endif %}</div>
<div class="queuebar">
  <button class="playall" onclick="toggleQueue()">▶ Play all</button>
  <span class="queuehint">plays every rec via YouTube · your keyboard's media keys skip tracks, even with this tab in the background</span>
</div>

{% include "_top_picks.html.j2" %}

{% from "_seed_block.html.j2" import seed_block %}
{% for seed, release, groups in seeds %}
{{ seed_block(seed, release, groups) }}
{% endfor %}
</div>
<script src="https://open.spotify.com/embed/iframe-api/v1" async></script>
<script src="https://www.youtube.com/iframe_api" async></script>
<script>
{% include "_player.js" %}
</script>
</body>
</html>
