{# The 💡 self-capture inbox: raw notes jotted from any page, newest first.
   Mirrors queue.html.j2's structure (rows, ×, footer) but for free-text notes
   instead of tracks — see todo_inbox.py for the storage shape. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>teCrawl — inbox</title>
<style>
{% include "_style.css" %}
.wrap { max-width: 720px; }
.note {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: .75rem;
  padding: .85rem 1rem;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: .6rem;
}
.note-body { min-width: 0; }
.note-text { white-space: pre-wrap; word-break: break-word; }
.note-meta { color: var(--muted); font-size: .75rem; margin-top: .3rem; }
.note .rm {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--muted);
  border-radius: 3px;
  padding: .14rem .4rem;
  cursor: pointer;
  font-size: .8rem;
  font-family: inherit;
  line-height: 1;
  flex: none;
}
.note .rm:hover { border-color: #ff4c4c; color: #ff4c4c; }
.none { color: var(--muted); padding: 1.5rem 0; font-size: .9rem; }
.footer {
  margin-top: 3rem;
  padding-top: .75rem;
  border-top: 1px solid var(--border);
  color: #555;
  font-size: .72rem;
}
</style>
</head>
<body>
<div class="wrap">
<div class="meta"><a href="/">← All playlists</a> · <a href="/queue">⬇ Download queue</a></div>
<h1>💡 Inbox</h1>
<div class="meta"><span id="count">{{ entries|length }}</span> open note<span id="plural">{{ '' if entries|length == 1 else 's' }}</span> · newest first</div>
<div id="rows">
{% for e in entries %}
  <div class="note" data-id="{{ e.id }}">
    <div class="note-body">
      <div class="note-text">{{ e.text }}</div>
      <div class="note-meta">{{ (e.ts or '')[:16] | replace('T', ' ') }}{% if e.page %} · {{ e.page }}{% endif %}{% if e.seed %} · from {{ e.seed }}{% endif %}</div>
    </div>
    <button class="rm" onclick="resolveEntry(this)" title="Mark resolved">×</button>
  </div>
{% endfor %}
</div>
{% if not entries %}
<div class="none">Nothing in the inbox — hit 💡 on any page to jot something down.</div>
{% endif %}
<div class="footer">stored in <code>todo_inbox.jsonl</code> · server started {{ server_started }}</div>
</div>
{% include "_todo_capture.html.j2" %}
<script>
function refreshCount(n) {
  document.getElementById('count').textContent = n;
  document.getElementById('plural').textContent = n === 1 ? '' : 's';
}
function resolveEntry(btn) {
  const row = btn.closest('.note');
  btn.disabled = true;
  fetch('/api/todo', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ action: 'resolve', id: row.dataset.id }),
  }).then(function (r) {
    if (!r.ok) throw new Error('bad status');
    return r.json();
  }).then(function (d) {
    if (d.error) throw new Error(d.error);
    row.remove();
    refreshCount(document.querySelectorAll('#rows .note').length);
  }).catch(function () {
    btn.disabled = false;
    alert('Resolving failed — is the tecrawl server running?');
  });
}
</script>
</body>
</html>
